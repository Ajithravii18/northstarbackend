# Local development starts an ephemeral MongoDB unless MONGODB_URI is set.
# Use a replica-set-enabled MongoDB deployment for local persistence and production.
# MONGODB_URI=mongodb://127.0.0.1:27017/northstar_access?replicaSet=rs0

# Production requires:
# NODE_ENV=production
# MONGODB_URI=<MongoDB connection string>
# JWT_SECRET=<unique random secret, at least 32 characters>
# ADMIN_BOOTSTRAP_TOKEN=<separate one-time setup token, at least 32 characters>
# APP_ORIGINS=https://your-application.example
# PORT=4000
# RESEND_API_KEY=re_your_secret_key
# PASSWORD_RESET_FROM_EMAIL=security@your-verified-domain.example
# Frontend build setting (configure in the frontend hosting dashboard):
# VITE_API_BASE_URL=https://your-api.example.com/api
